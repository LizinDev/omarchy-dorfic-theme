#!/bin/bash
# Per-theme fastfetch logo (Omarchy theme-set hook).
#
# Install: cp tools/fastfetch-hook ~/.config/omarchy/hooks/theme-set.d/50-fastfetch-logo
#
# Omarchy's fastfetch config (/etc/fastfetch/config.jsonc) prints one global
# logo. When the applied theme ships a fastfetch.txt (truecolor art), this
# writes ~/.config/fastfetch/config.jsonc: the /etc config with the logo
# swapped for that art. Raw art carries escape codes fastfetch cannot measure,
# so the width and height are measured here. Themes without one get the stock
# logo back: the generated config is removed. A config that does not carry the
# marker below is the user's own and is never touched.

THEME_DIR="$HOME/.local/state/omarchy/current/theme"
SYSTEM_CONFIG="/etc/fastfetch/config.jsonc"
USER_CONFIG="$HOME/.config/fastfetch/config.jsonc"
LOGO="$HOME/.cache/omarchy/fastfetch-logo.txt"
MARKER="// generated by the omarchy theme-set hook 50-fastfetch-logo"

[[ -f $SYSTEM_CONFIG ]] || exit 0
if [[ -f $USER_CONFIG ]] && ! head -n 1 "$USER_CONFIG" | grep -qxF "$MARKER"; then
  exit 0
fi

if [[ ! -f $THEME_DIR/fastfetch.txt ]]; then
  rm -f "$USER_CONFIG" "$LOGO"
  exit 0
fi

mkdir -p "$(dirname "$LOGO")" "$(dirname "$USER_CONFIG")"
cp "$THEME_DIR/fastfetch.txt" "$LOGO"

python3 -I - "$SYSTEM_CONFIG" "$USER_CONFIG" "$LOGO" "$MARKER" <<'EOF'
import json
import re
import sys

system, out, logo, marker = sys.argv[1:5]
config = json.load(open(system))
lines = open(logo, encoding='utf-8').read().splitlines()
plain = [re.sub(r'\x1b\[[0-9;]*m', '', line) for line in lines]
padding = config.get('logo', {}).get('padding', {})
config['logo'] = {
    'type': 'file-raw',
    'source': logo,
    'width': max((len(line) for line in plain), default=0),
    'height': len(lines),
    'padding': padding,
}
with open(out + '.tmp', 'w') as f:
    f.write(marker + '\n' + json.dumps(config, indent=2, ensure_ascii=False) + '\n')
EOF
mv "$USER_CONFIG.tmp" "$USER_CONFIG"
